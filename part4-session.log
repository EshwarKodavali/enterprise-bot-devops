    APP_MODE: "reporter"
    APP_NAME: "reporter"
    VERSION: "2.0.0"
    PORT: "8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

metrics:
