  env:
    APP_MODE: "worker"
    APP_NAME: "worker"
    VERSION: "2.0.0"
    PORT: "8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

reporter:
