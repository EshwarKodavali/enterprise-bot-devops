import tarfile, json, io

archive = tarfile.open('/tmp/eb-debug-app.tar')
manifest = json.load(archive.extractfile('manifest.json'))[0]

for layer in manifest['Layers']:
    blob = archive.extractfile(layer)
    try:
        layer_tar = tarfile.open(fileobj=blob, mode='r:*')
        for member in layer_tar.getmembers():
            if member.name.lstrip('./') == 'etc/passwd':
                print('Found /etc/passwd in layer:', layer)
                print(layer_tar.extractfile(member).read().decode())
    except tarfile.ReadError:
        pass
PY
