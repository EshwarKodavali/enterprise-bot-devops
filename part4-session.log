from pathlib import Path

templates = [
    "backend.yaml",
    "gateway.yaml",
    "metrics.yaml",
    "migrate-job.yaml",
    "reporter.yaml",
    "worker.yaml",
]

directory = Path("lab/broken-chart/templates")

for name in templates:
    path = directory / name
    content = path.read_text()
    old = "            runAsNonRoot: true\n"
    new = old + "            runAsUser: 65532\n"

    if content.count(old) != 1:
        raise SystemExit(f"Expected exactly one runAsNonRoot entry in {path}")

    path.write_text(content.replace(old, new, 1))
    print(f"Updated {path}")
PY
